{
  "name": "shortclips-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && (npm run rbac:sync || echo \"[rbac-sync] mislukt, zie log hierboven\") && (npm run kb:import || echo \"[kennisbank-import] mislukt, zie log hierboven\") && (npm run kosten:seed || echo \"[kosten-seed] mislukt, zie log hierboven\") && (npm run vermogen:seed || echo \"[vermogen-seed] mislukt, zie log hierboven\") && (npm run data:fixes || echo \"[data-fixes] mislukt, zie log hierboven\") && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "rbac:sync": "tsx scripts/rbac-sync.ts",
    "db:reset": "rm -rf .data/pglite && npm run db:migrate && npm run db:seed",
    "restore:data": "tsx scripts/restore-data.ts",
    "db:studio": "drizzle-kit studio",
    "google:token": "node scripts/google-refresh-token.mjs",
    "frameio:token": "node scripts/frameio-token.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "kb:import": "tsx scripts/kennisbank-import.ts",
    "kosten:seed": "tsx scripts/kosten-seed.ts",
    "vi:worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/vi-worker.ts",
    "quotes:import-pandadoc": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-pandadoc.ts",
    "quotes:seed-templates": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-quote-templates.ts",
    "vermogen:seed": "tsx scripts/vermogen-seed.ts",
    "data:fixes": "tsx scripts/data-fixes.ts",
    "portal:testclients": "tsx scripts/portal-test-clients.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.5",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "^2.58.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.5.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "imapflow": "^2.9.1",
    "lucide-react": "^1.31.0",
    "mailparser": "^3.12.4",
    "mammoth": "^1.13.0",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "puppeteer-core": "^24.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
